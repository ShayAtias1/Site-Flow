    "test:m3:webkit": "tsx scripts/m3-tests.ts webkit",
    "test:m4": "tsx scripts/m4-tests.ts",
    "test:m4:webkit": "tsx scripts/m4-tests.ts webkit",
    "test:m5": "tsx scripts/m5-tests.ts",
    "test:m5:webkit": "tsx scripts/m5-tests.ts webkit",
    "test:m9": "tsx scripts/m9-tests.ts",
    "test:m9:webkit": "tsx scripts/m9-tests.ts webkit",
    "test:ux": "tsx scripts/ux-tests.ts",
    "test:ux:webkit": "tsx scripts/ux-tests.ts webkit",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "dexie": "^4.4.6",
